.label{font-size:24rpx;font-weight:800;margin:42rpx 0 16rpx}.types{display:flex;flex-wrap:wrap;gap:14rpx}.type{padding:16rpx 22rpx;background:#fff;border:2rpx solid #e4e8ef;border-radius:16rpx;font-size:22rpx}.type.active{background:#fff0eb;border-color:#ff6944;color:#d95130}.input,.textarea{width:100%;box-sizing:border-box;background:#fff;border:2rpx solid #e1e6ee;border-radius:18rpx;padding:22rpx;font-size:25rpx}.textarea{height:190rpx}.tip{font-size:21rpx;line-height:1.7;color:#758195;background:#eef3f8;border-radius:18rpx;padding:24rpx;margin-top:28rpx}.submit{margin-top:30rpx}
