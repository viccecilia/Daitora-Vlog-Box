<view class="page"><view class="title">我的成品</view><view wx:if="{{loading}}" class="card muted">正在读取最新成品…</view><view wx:elif="{{!product}}" class="card muted">暂时没有新成品，剪辑师回传后会显示在这里。</view><block wx:else><view class="kicker">{{product.status === 'pending' ? '待确认' : product.status}}</view><video wx:if="{{previewPath}}" class="cover" src="{{previewPath}}" controls object-fit="contain"/><view wx:else class="card muted">正在准备视频预览…</view><view class="card info"><b>{{product.title}}</b><view class="muted">{{product.originalName}} · V{{product.versionNumber || 1}}</view></view><view class="card info"><b>版本历史</b><view wx:for="{{versions}}" wx:key="id" class="muted">V{{item.version_number}} · {{item.original_name}} · {{item.status}}</view></view><button class="ghost action" bindtap="revise">提出修改</button><button class="primary action" bindtap="confirm">确认完成</button><button class="secondary action" loading="{{downloading}}" disabled="{{downloading}}" bindtap="download">{{downloading ? '正在下载' : '下载到手机'}}</button></block></view>
