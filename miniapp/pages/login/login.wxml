<view class="login-page">
  <image class="logo" src="/assets/vlog-box-logo.png" mode="aspectFit" />
  <view class="sub">VLOG BOX</view>
  <view class="welcome">登录素材协作中心</view>
  <view class="login-form">
    <view class="field">
      <view class="field-label">账号</view>
      <input placeholder="输入用户名" value="{{account}}" bindinput="onAccountInput" confirm-type="next" />
    </view>
    <view class="field">
      <view class="field-label">密码</view>
      <view class="password-row">
        <input class="password-input" placeholder="请输入密码" password="{{!showPassword}}" value="{{password}}" bindinput="onPasswordInput" confirm-type="done" bindconfirm="login" />
        <text class="password-toggle" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</text>
      </view>
    </view>
  </view>
  <button class="primary login" loading="{{loading}}" disabled="{{loading}}" bindtap="login">登录</button>
</view>
