.login-page{min-height:100vh;background:linear-gradient(160deg,#fff,#fff5f1);padding:110rpx 58rpx;text-align:center;box-sizing:border-box}.logo{width:108rpx;height:108rpx;line-height:108rpx;margin:auto;border-radius:30rpx;background:#ff6944;color:white;font-size:58rpx;font-weight:900}.brand{font-size:44rpx;font-weight:800;margin-top:28rpx}.sub{font-size:18rpx;letter-spacing:7rpx;color:#9aa4b3}.welcome{font-size:30rpx;margin:68rpx 0 32rpx}.login-form{text-align:left}.field{margin-top:24rpx}.field-label{font-size:24rpx;font-weight:700;color:#4d5a70;margin:0 0 12rpx 6rpx}.field input{height:92rpx;padding:0 28rpx;border:1rpx solid #dfe5ee;border-radius:18rpx;background:#fff;font-size:28rpx;box-sizing:border-box}.password-row{display:flex;align-items:center;border:1rpx solid #dfe5ee;border-radius:18rpx;background:#fff}.password-row .password-input{flex:1;border:0;background:transparent}.password-toggle{padding:24rpx;color:#2767e8;font-size:24rpx}.login{margin-top:36rpx;height:94rpx;line-height:94rpx}.hint{font-size:22rpx;color:#7c8799;line-height:1.7;margin-top:30rpx}.demo-hint{font-size:20rpx;color:#a1a9b7;line-height:1.7;margin-top:18rpx}
