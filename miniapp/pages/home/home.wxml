<view class="page">
  <view class="home-profile"><view><view class="kicker">{{user.id}}</view><view class="muted">{{user.name}}</view></view><button bindtap="logout">退出登录</button></view><view class="title">素材与成品</view><view class="muted">上传原始素材，或查看剪辑师回传的最新成品。</view>
  <view class="actions">
    <view class="action upload" bindtap="goUpload"><view class="icon">↑</view><view><view class="name">上传素材</view><view class="desc">照片与视频，可多选</view></view><view class="arrow">›</view></view>
    <view class="action result" bindtap="goResult"><view class="icon">↓</view><view><view class="name">我的成品</view><view class="desc">预览、下载、确认或提出修改</view></view><view class="arrow">›</view></view>
  </view>
</view>
