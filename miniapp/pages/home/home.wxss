.actions{margin:54rpx 0 28rpx}.action{height:150rpx;border-radius:28rpx;color:#fff;display:flex;align-items:center;padding:0 28rpx;margin-bottom:22rpx;box-shadow:0 20rpx 42rpx rgba(23,32,51,.14)}.upload{background:linear-gradient(135deg,#ff7a57,#ee4f2e)}.result{background:linear-gradient(135deg,#3479ee,#1758cc)}.icon{width:74rpx;height:74rpx;line-height:74rpx;text-align:center;background:rgba(255,255,255,.16);border-radius:22rpx;font-size:44rpx;margin-right:24rpx}.name{font-size:32rpx;font-weight:800}.desc{font-size:21rpx;opacity:.75;margin-top:8rpx}.arrow{margin-left:auto;font-size:52rpx}.status{display:flex;justify-content:space-around;text-align:center}.status b{display:block;font-size:40rpx}.status text{font-size:20rpx;color:#8b95a5}.recent-title{font-size:27rpx;font-weight:800;margin:48rpx 0 18rpx}.package-item{display:flex;align-items:center;gap:20rpx;margin-top:14rpx;padding:24rpx 26rpx}.package-main{min-width:0;flex:1}.package-context{display:flex;align-items:center;color:#6f7c91;font-size:20rpx;font-weight:600;line-height:1}.package-context .dot{margin:0 10rpx;color:#b1b8c4}.package-name{margin-top:13rpx;color:#172033;font-size:29rpx;font-weight:700;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.package-meta{margin-top:10rpx;color:#8b95a5;font-size:19rpx;line-height:1.35}.tag{flex:0 0 auto;background:#fff0eb;color:#d65231;padding:9rpx 14rpx;border-radius:99rpx;font-size:19rpx;white-space:nowrap}.home-profile{display:flex;align-items:center;justify-content:space-between}.home-profile button{margin:0;background:#fff;border:1rpx solid #dfe4ec;color:#526078;font-size:22rpx}
