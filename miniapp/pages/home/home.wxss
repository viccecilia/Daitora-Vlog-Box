.actions{margin:54rpx 0 28rpx}.action{height:150rpx;border-radius:28rpx;color:#fff;display:flex;align-items:center;padding:0 28rpx;margin-bottom:22rpx;box-shadow:0 20rpx 42rpx rgba(23,32,51,.14)}.upload{background:linear-gradient(135deg,#ff7a57,#ee4f2e)}.result{background:linear-gradient(135deg,#3479ee,#1758cc)}.icon{width:74rpx;height:74rpx;line-height:74rpx;text-align:center;background:rgba(255,255,255,.16);border-radius:22rpx;font-size:44rpx;margin-right:24rpx}.name{font-size:32rpx;font-weight:800}.desc{font-size:21rpx;opacity:.75;margin-top:8rpx}.arrow{margin-left:auto;font-size:52rpx}.status{display:flex;justify-content:space-around;text-align:center}.status b{display:block;font-size:40rpx}.status text{font-size:20rpx;color:#8b95a5}.recent-title{font-size:27rpx;font-weight:800;margin:48rpx 0 18rpx}.small{font-size:20rpx;margin-top:8rpx}.tag{background:#fff0eb;color:#d65231;padding:10rpx 16rpx;border-radius:99rpx;font-size:20rpx}
