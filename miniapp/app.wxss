page{background:#f5f7fb;color:#172033;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{padding:32rpx}.card{background:#fff;border-radius:28rpx;padding:30rpx;box-shadow:0 16rpx 50rpx rgba(31,49,84,.06)}.kicker{font-size:20rpx;color:#8993a6;letter-spacing:2rpx;font-weight:700}.title{font-size:48rpx;font-weight:800;margin:18rpx 0 10rpx}.muted{font-size:25rpx;color:#7e899a}.primary{background:#ff6944!important;color:#fff!important;border-radius:20rpx!important;font-weight:700}.secondary{background:#2468e8!important;color:#fff!important;border-radius:20rpx!important;font-weight:700}.ghost{background:#fff!important;color:#4f5c70!important;border:1rpx solid #e1e6ee!important;border-radius:18rpx!important}.row{display:flex;align-items:center}.between{justify-content:space-between}
